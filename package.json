{
  "name": "langchain-x402-nano",
  "version": "0.1.0",
  "description": "LangChain tool that pays Nano (XNO) x402 'exact' quotes on nano:mainnet behind a payment guard (allowlist, per-call and cumulative caps, single block per call, no cross-origin pay, no stale quotes).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": ["langchain", "tool", "x402", "nano", "xno", "payments", "agents"],
  "license": "MIT",
  "scripts": { "build": "tsc -p .", "test": "vitest run", "prepublishOnly": "npm run build && npm test" },
  "dependencies": { "nanocurrency": "2.5.0", "zod": "3.25.76" },
  "peerDependencies": { "@langchain/core": "^1.0.0" },
  "devDependencies": { "@langchain/core": "1.3.2", "@types/node": "22.19.1", "typescript": "5.9.3", "vitest": "4.1.12" }
}
